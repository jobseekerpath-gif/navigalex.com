# AI assistant providers (at least one required for AI-powered analysis and chat)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5-20250929"
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_LOCATION="us-central1"
VERTEX_MODEL="gemini-2.5-flash"

# Public site URL
APP_URL="https://navigalex.com"

# Inquiry delivery (required for contact submissions to report success)
# Create an API key at https://resend.com and verify the sender domain first.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Navigalex <inquiries@navigalex.com>"
INQUIRY_TO_EMAIL=""

# Admin access: use a long unique password in the hosting provider's secret variables.
# Never commit real credentials to this file or the repository.
ADMIN_USERNAME="admin"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Point at a durable mounted volume in production. This JSON store is for a single
# running instance; use a shared database before deploying multiple replicas.
NAVIGALEX_DATA_DIR="./data"
